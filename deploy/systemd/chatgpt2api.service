[Unit]
Description=ChatGPT2API (cgpt-pool-ng)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/chatgpt2api
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/chatgpt2api/.venv/bin/python main.py
Restart=always
RestartSec=3
LimitNOFILE=65535
# 出口池与告警均为进程内实现，无需额外 sidecar

[Install]
WantedBy=multi-user.target
